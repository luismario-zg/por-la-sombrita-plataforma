[Unit]
Description=Actualizar fuentes públicas del asistente Por la Sombrita
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/claude/projects/por-la-sombrita-plataforma
Environment=PLS_DATA_DIR=/home/claude/.local/share/pls-plataforma
ExecStart=/home/claude/projects/por-la-sombrita-plataforma/.venv/bin/python scripts/indexar_fuentes_asistente.py
TimeoutStartSec=300
NoNewPrivileges=true
UMask=0077
CPUQuota=25%
MemoryMax=256M
